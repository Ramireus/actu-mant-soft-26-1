<div class="row">
  <div class="col-md-12">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h1 class="h2">📖 Historial Clínico (Solo Lectura)</h1>
        <p class="text-muted">
          Mascota: <strong><%= pet_name %></strong> | 
          Propietario: <strong><%= owner_name %></strong>
        </p>
      </div>
      <a href="/" class="btn btn-secondary">← Volver</a>
    </div>

    <% if (!records || records.length === 0) { %>
      <div class="alert alert-info text-center py-5">
        <p class="mb-0"><%= message || 'No hay registros médicos para esta mascota.' %></p>
      </div>
    <% } else { %>
      <div class="timeline">
        <% records.forEach((record, index) => { %>
          <div class="card mb-3 border-left-primary" style="border-left: 4px solid #6c5ce7;">
            <div class="card-body">
              <div class="row">
                <div class="col-md-8">
                  <h5 class="card-title">
                    Visita #<%= index + 1 %>
                    <span class="badge bg-info ms-2"><%= record.service || 'Consulta' %></span>
                  </h5>
                  <p class="card-text text-muted mb-2">
                    <small>
                      📅 <%= new Date(record.created_at).toLocaleDateString('es-ES', { 
                        year: 'numeric', month: 'long', day: 'numeric', 
                        hour: '2-digit', minute: '2-digit' 
                      }) %>
                      <% if (record.recorded_by) { %>
                        | 👨‍⚕️ Registrado por: <%= record.recorded_by %>
                      <% } %>
                    </small>
                  </p>
                </div>
                <div class="col-md-4 text-end">
                  <a href="/medical/record/<%= record.id %>" class="btn btn-sm btn-outline-primary">Ver Detalle</a>
                </div>
              </div>

              <!-- Datos médicos (solo lectura) -->
              <div class="row mt-3">
                <div class="col-md-6">
                  <p class="mb-2">
                    <strong>⚖️ Peso:</strong> 
                    <span class="text-muted"><%= record.weight ? record.weight + ' kg' : 'No registrado' %></span>
                  </p>
                  <p class="mb-2">
                    <strong>🌡️ Temperatura:</strong> 
                    <span class="text-muted"><%= record.temperature ? record.temperature + ' °C' : 'No registrado' %></span>
                  </p>
                  <p class="mb-2">
                    <strong>🔍 Diagnóstico:</strong> 
                    <span class="text-muted"><%= record.diagnosis || 'No registrado' %></span>
                  </p>
                </div>
                <div class="col-md-6">
                  <p class="mb-2">
                    <strong>💊 Medicina:</strong>
                  </p>
                  <p class="text-muted"><%= record.medicine || 'No prescrita' %></p>
                  <% if (record.is_medical_consultation) { %>
                    <span class="badge bg-warning text-dark">Consulta Médica</span>
                  <% } %>
                </div>
              </div>

              <% if (record.notes) { %>
                <div class="mt-3 p-3 bg-light border-start border-warning">
                  <strong>📝 Notas:</strong>
                  <p class="text-muted mb-0"><%= record.notes %></p>
                </div>
              <% } %>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</div>

<style>
  .timeline { position: relative; }
  .timeline::before { 
    content: ''; 
    position: absolute; 
    left: 0; 
    top: 0; 
    bottom: 0; 
    width: 4px; 
    background: #e0e0e0; 
  }
</style>
