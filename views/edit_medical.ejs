<div class="row justify-content-center">
  <div class="col-md-8 col-lg-8">
    <div class="card">
      <div class="card-body p-4">
        <h2 class="card-title text-center mb-4">📋 Editar Expediente Médico</h2>
        <h5 class="text-muted mb-4">
          Mascota: <strong><%= appointment.pet_name %></strong> | 
          Propietario: <strong><%= appointment.owner_name %></strong>
        </h5>

        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-danger"><%= error %></div>
        <% } %>
        
        <form action="/medical/<%= appointment.id %>" method="POST" id="medicalForm">
          <div class="mb-3">
            <div class="form-check">
              <input type="checkbox" class="form-check-input" id="is_medical_consultation" name="is_medical_consultation" 
                <% if (appointment.is_medical_consultation) { %>checked<% } %>>
              <label class="form-check-label" for="is_medical_consultation">
                ⚕️ <strong>Esta es una consulta médica</strong> (requiere Peso, Temperatura y Diagnóstico)
              </label>
            </div>
          </div>

          <div class="alert alert-info" id="requiredFieldsAlert" style="display: none;">
            <strong>⚠️ Campos obligatorios en consulta médica:</strong>
            <ul class="mb-0">
              <li>Peso (kg)</li>
              <li>Temperatura (°C)</li>
              <li>Diagnóstico</li>
            </ul>
          </div>

          <div class="row">
            <div class="col-md-6 mb-3">
              <label for="weight" class="form-label">
                Peso (kg) <span class="required-badge" style="display: none; color: red;">*</span>
              </label>
              <input type="number" step="0.1" class="form-control" id="weight" name="weight" 
                value="<%= appointment.weight || '' %>" placeholder="Ej: 25.5">
              <small class="form-text text-muted">Requerido en consulta médica</small>
            </div>
            <div class="col-md-6 mb-3">
              <label for="temperature" class="form-label">
                Temperatura (°C) <span class="required-badge" style="display: none; color: red;">*</span>
              </label>
              <input type="number" step="0.1" class="form-control" id="temperature" name="temperature" 
                value="<%= appointment.temperature || '' %>" placeholder="Ej: 38.5">
              <small class="form-text text-muted">Requerida en consulta médica</small>
            </div>
          </div>

          <div class="row">
            <div class="col-md-12 mb-3">
              <label for="diagnosis" class="form-label">
                Diagnóstico <span class="required-badge" style="display: none; color: red;">*</span>
              </label>
              <input type="text" class="form-control" id="diagnosis" name="diagnosis" 
                value="<%= appointment.diagnosis || '' %>" placeholder="Ej: Alergias de piel">
              <small class="form-text text-muted">Requerido en consulta médica</small>
            </div>
          </div>

          <div class="row">
            <div class="col-md-6 mb-3">
              <label for="medicine" class="form-label">Medicina Recetada</label>
              <input type="text" class="form-control" id="medicine" name="medicine" 
                value="<%= appointment.medicine || '' %>" placeholder="Ej: Amoxicilina 500mg c/8h">
              <small class="form-text text-muted">Opcional</small>
            </div>
          </div>

          <div class="mb-3">
            <label for="medical_notes" class="form-label">Notas Médicas Adicionales</label>
            <textarea class="form-control" id="medical_notes" name="medical_notes" rows="4" 
              placeholder="Observaciones clínicas, recomendaciones, etc."><%= appointment.medical_notes || '' %></textarea>
            <small class="form-text text-muted">Opcional</small>
          </div>

          <div class="d-grid gap-2">
            <button type="submit" class="btn btn-primary">💾 Guardar Expediente</button>
            <a href="/" class="btn btn-link text-muted">Cancelar</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const checkbox = document.getElementById('is_medical_consultation');
    const alertBox = document.getElementById('requiredFieldsAlert');
    const requiredBadges = document.querySelectorAll('.required-badge');
    
    function updateUI() {
        if (checkbox.checked) {
            alertBox.style.display = 'block';
            requiredBadges.forEach(badge => badge.style.display = 'inline');
        } else {
            alertBox.style.display = 'none';
            requiredBadges.forEach(badge => badge.style.display = 'none');
        }
    }
    
    checkbox.addEventListener('change', updateUI);
    updateUI(); // Initial state
});
</script>
