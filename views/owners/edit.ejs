<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <h1>✏️ Editar Dueño</h1>

            <form method="POST" action="/owners/edit/<%= owner.id %>">
                <div class="mb-3">
                    <label for="name" class="form-label">Nombre del Dueño *</label>
                    <input type="text" class="form-control" id="name" name="name" value="<%= owner.name %>" required>
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary">Actualizar Dueño</button>
                    <a href="/owners" class="btn btn-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>
